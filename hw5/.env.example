# Copy this file to .env in Homework-5/ and fill in your own key. Never commit .env.
# The agents (backend/agents.py) read PORTKEY_API_KEY from the environment or from this .env.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional, for tests or experiments only: an ABSOLUTE path to another working copy of the database.
# The MCP server and ledger refuse a path that points at the original data/campus_customs.db.
# CAMPUS_CUSTOMS_DB=/absolute/path/to/a/copy_of_campus_customs.db
